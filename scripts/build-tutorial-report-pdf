#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: scripts/build-tutorial-report-pdf REPORT.typ REPORT.pdf" >&2
  exit 2
fi

input_path="$(realpath "$1")"
output_path="$(realpath -m "$2")"

if [[ ! -f "$input_path" ]]; then
  echo "Typst report does not exist: $input_path" >&2
  exit 2
fi
if ! command -v typst >/dev/null 2>&1; then
  echo "Typst is required to render the report PDF." >&2
  exit 2
fi

mkdir -p "$(dirname "$output_path")"
input_dir="$(dirname "$input_path")"
input_name="$(basename "$input_path")"
cd "$input_dir"
exec typst compile --root . "$input_name" "$output_path"
