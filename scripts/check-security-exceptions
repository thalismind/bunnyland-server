#!/usr/bin/env python3
"""Fail CI when scanner exceptions are broad, expired, or overdue for review."""

from __future__ import annotations

import re
from datetime import date
from pathlib import Path

from security_exceptions import load_scanner_exceptions


ROOT = Path(__file__).resolve().parents[1]
EXCEPTIONS_FILE = ROOT / ".scanner-exceptions.yaml"
GRYPE_FILE = ROOT / ".grype.yaml"


def _grype_exceptions(text: str) -> set[tuple[str, str]]:
    return {
        (advisory, package.lower())
        for advisory, package in re.findall(
            r"(?m)^  - vulnerability:\s+(\S+)\s*$"
            r"\n    package:\s*$\n      name:\s+(\S+)\s*$",
            text,
        )
    }


def main() -> None:
    try:
        entries = load_scanner_exceptions(EXCEPTIONS_FILE, today=date.today())
        grype_text = GRYPE_FILE.read_text(encoding="utf-8")
    except (OSError, ValueError) as exc:
        raise SystemExit(str(exc)) from exc

    manifest_exceptions = {(entry.advisory, entry.package) for entry in entries}
    configured_exceptions = _grype_exceptions(grype_text)
    if configured_exceptions != manifest_exceptions:
        raise SystemExit(
            f"{GRYPE_FILE}: scanner ignores must exactly match documented exceptions"
        )

    for entry in entries:
        document, anchor = entry.tracking_issue.split("#", 1)
        document_path = ROOT / document
        try:
            documentation = document_path.read_text(encoding="utf-8").lower()
        except OSError as exc:
            raise SystemExit(str(exc)) from exc
        if f"## {anchor}" not in documentation:
            raise SystemExit(
                f"{document_path}: missing tracking heading for {entry.advisory}"
            )


if __name__ == "__main__":
    main()
