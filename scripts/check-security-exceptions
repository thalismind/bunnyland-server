#!/usr/bin/env python3
"""Fail CI when a scanner exception is expired or misses its weekly review."""

from __future__ import annotations

import re
from datetime import date, timedelta
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
EXCEPTIONS_FILE = ROOT / ".scanner-exceptions.yaml"
GRYPE_FILE = ROOT / ".grype.yaml"


def field(name: str, text: str) -> str:
    match = re.search(
        rf"(?m)^\s+(?:-\s+)?{re.escape(name)}:\s+(\S+)\s*$",
        text,
    )
    if match is None:
        raise SystemExit(f"{EXCEPTIONS_FILE}: missing {name}")
    return match.group(1)


def main() -> None:
    text = EXCEPTIONS_FILE.read_text(encoding="utf-8")
    grype_text = GRYPE_FILE.read_text(encoding="utf-8")
    today = date.today()
    advisory = field("id", text)
    expires = date.fromisoformat(field("expired_at", text))
    reviewed = date.fromisoformat(field("last_reviewed_at", text))
    interval = int(field("review_interval_days", text))
    tracking = field("tracking_issue", text)

    if field("scanner", text) != "grype":
        raise SystemExit(f"{EXCEPTIONS_FILE}: scanner must be grype")
    if not re.search(
        rf"(?m)^\s+- vulnerability:\s+{re.escape(advisory)}\s*$",
        grype_text,
    ):
        raise SystemExit(f"{GRYPE_FILE}: missing exception for {advisory}")
    if not tracking.startswith("docs/") or "#" not in tracking:
        raise SystemExit(
            f"{EXCEPTIONS_FILE}: tracking_issue must link to a repository issue"
        )
    if today > expires:
        raise SystemExit(
            f"{EXCEPTIONS_FILE}: exception expired on {expires.isoformat()}"
        )
    if today > reviewed + timedelta(days=interval):
        raise SystemExit(
            f"{EXCEPTIONS_FILE}: review overdue since "
            f"{(reviewed + timedelta(days=interval)).isoformat()}"
        )


if __name__ == "__main__":
    main()
